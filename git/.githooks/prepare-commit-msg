#!/bin/bash
set -euo pipefail

# Global prepare-commit-msg hook (installed via core.hooksPath = ~/.githooks).
# In a project notes repository (projectnotes.coderepo, set by project_notes),
# append a `Code: <repo>@<sha>` trailer linking the notes commit to the code
# state it was written against: the main checkout's HEAD, since the shared
# notes clone can't tell which worktree a commit came from. Best-effort: a
# failed lookup skips the trailer, never the commit. Merges, squashes, and
# amends ($2 = merge|squash|commit) are skipped to avoid noise.
msg_file=$1
code_repo=$(git config --get projectnotes.coderepo || true)
if [ -n "$code_repo" ] && [[ ! ${2:-} =~ ^(merge|squash|commit)$ ]] && ! grep -q '^Code: ' "$msg_file"; then
  # The hook inherits this repo's GIT_DIR/GIT_INDEX_FILE; drop them for the lookup.
  sha=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE git -C "$code_repo" rev-parse --short HEAD 2>/dev/null || true)
  if [ -n "$sha" ]; then
    # interpret-trailers places the trailer before comments and the
    # commit.verbose scissors line; a plain append would land below them.
    git interpret-trailers --in-place --trailer "Code: $(basename "$code_repo")@$sha" "$msg_file"
  fi
fi

# Chain to the repo's own hook; see chain-repo-hook for why --git-common-dir.
repo_hook=$(git rev-parse --git-common-dir)/hooks/prepare-commit-msg
if [ -x "$repo_hook" ]; then
  exec "$repo_hook" "$@"
fi
