#!/bin/bash
set -euo pipefail

# Global commit-msg hook (installed via core.hooksPath = ~/.githooks).
# Rejects AI-attribution mentions (Claude/Codex trailers, session links,
# "Generated with" lines) in commit messages. It deliberately does NOT match
# the bare words "claude"/"codex" — modules/packages legitimately carry those
# names (e.g. the dotfiles `claude` and `codex` stow packages).

msg_file=$1

comment_char=$(git config --get core.commentchar || echo '#')
# "auto" makes git pick a char per-message; it still defaults to '#' first
[ "$comment_char" = auto ] && comment_char='#'

# Keep only the real message: stop at the verbose-commit scissors line
# (commit.verbose appends the full diff below it, which must not trigger the
# check — e.g. when editing this very hook), then drop comment lines.
msg=$(sed -n "/^${comment_char} -\{8,\} >8 -\{8,\}\$/q;p" "$msg_file" | grep -v "^${comment_char}" || true)

agents='claude|codex|chatgpt|openai'
patterns=(
  '(claude|codex)-session:'
  'claude\.ai/code'
  'chatgpt\.com/codex'
  "(co-)?authored-by:.*($agents)"
  "signed-off-by:.*($agents)"
  # bounded gap: an unbounded .* false-positives on prose like
  # "Generated by nginxconfig.io ... per CLAUDE.md" in one line
  "generated (with|by).{0,20}($agents)"
  'noreply@(anthropic|openai)'
)

for p in "${patterns[@]}"; do
  if match=$(grep -i -E -m1 -- "$p" <<<"$msg"); then
    echo "commit-msg: AI attribution is not allowed in commit messages" >&2
    echo "  offending line: $match" >&2
    exit 1
  fi
done

# core.hooksPath masks per-repo hooks entirely, so chain to the repo's own
# commit-msg hook if it has one (husky, pre-commit framework, etc.). Must use
# --git-common-dir, not --git-path hooks/ (honors core.hooksPath and would
# resolve back to this very script, exec'ing it in an infinite loop) and not
# --git-dir (in a linked worktree that names the per-worktree gitdir, which
# has no hooks/ -- repo hooks are shared via the common dir).
repo_hook=$(git rev-parse --git-common-dir)/hooks/commit-msg
if [ -x "$repo_hook" ]; then
  exec "$repo_hook" "$@"
fi
