#!/usr/bin/env python3
"""Manage a code repository's private notes, kept in the Obsidian vault.

Each code repository's notes are their own git repository at
<vault>/Code/<name>. Its git directory lives outside iCloud, at
~/.local/share/project_notes/<name>.git, because iCloud sync mangles .git
internals (conflict copies of the index, evicted objects). Every checkout and
worktree of the code repository reaches the notes through a `notes` symlink
that is ignored via .git/info/exclude, so public repositories never see it.

The global post-checkout hook runs `project_notes link` for new clones and
worktrees. The Codex app runs git with hooks disabled, so `init` and `migrate`
also give the repository a Codex environment whose setup script links them.
The global pre-commit hook runs `project_notes lint` in notes repositories,
and the global commit-msg hook stamps notes commits with a `Code: <name>@<sha>`
trailer. Conventions for the notes themselves live in the project_notes agent
skill; `lint` and `fmt` hold the checks shared by every notes repository, with
one Markdown style (~/.config/project_notes/notes.markdownlint.yaml).

Must stay compatible with macOS's /usr/bin/python3 (3.9): git hooks launched
from GUI apps may not see the mise-managed interpreter.
"""

from __future__ import annotations

import argparse
import datetime
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

NOTES_ROOT = Path(
    os.environ.get(
        "PROJECT_NOTES_ROOT",
        "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/Home/Code",
    )
).expanduser()
GITDIR_ROOT = Path(os.environ.get("PROJECT_NOTES_GITDIRS", "~/.local/share/project_notes")).expanduser()
LINK_NAME = "notes"
CODE_REPO_KEY = "projectnotes.coderepo"
REMOTE_BASE_KEY = "projectnotes.remotebase"

# Meanings live in the project_notes skill; this is only the enforced set.
STATUSES = {"runbook", "current", "planned", "deferred", "rejected", "completed", "reference"}
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
ICLOUD_CONFLICT_RE = re.compile(r" \d+$")  # "foo 2.md": iCloud's conflict copy of "foo.md"
SF_DATALESS = 0x40000000  # macOS st_flags bit for an evicted iCloud placeholder
MARKDOWNLINT_CONFIG = Path("~/.config/project_notes/notes.markdownlint.yaml").expanduser()
# The mise shim runs without mise on PATH, e.g. in hooks launched by GUI apps;
# it needs MISE_ENV=mac to see the mac-only tool (and node, which runs it).
MARKDOWNLINT_SHIM = Path("~/.local/share/mise/shims/markdownlint-cli2").expanduser()

# Code fences and spans match first, so links inside them are never checked.
LINK_TOKEN_RE = re.compile(
    r"^(`{3,}|~{3,})[^\n]*\n.*?\n\1"
    r"|`+.+?`+"
    r"|!?\[[^\]]*\]\((?P<inline>[^)]+)\)"
    r"|^\[[^\]]+\]:[ \t]+(?P<ref>\S+)",
    re.MULTILINE | re.DOTALL,
)
URL_SCHEME_RE = re.compile(r"^[a-z][a-z0-9+.-]*:", re.IGNORECASE)
# git@host:owner/repo.git, ssh://git@host[:port]/owner/repo.git, https://host/owner/repo
REMOTE_RE = re.compile(r"^(?:[a-z+]+://)?(?:[^@/]+@)?(?P<host>[^:/]+)(?::\d+)?[:/](?P<path>.+?)(?:\.git)?/?$")

SOMEDAY_TEMPLATE = """---
status: reference # backlog; confirm with the operator before acting on any item
created_at: {date}
---

# Someday

Open follow-ups deferred from prior work. Not standing instructions.
"""

# The Codex app writes these files itself (hence the banner) and runs the setup
# script in each worktree it creates; see setup_codex_environment.
CODEX_ENV_DIR = Path(".codex/environments")
CODEX_ENV_TEMPLATE = """# THIS IS AUTOGENERATED. DO NOT EDIT MANUALLY
version = 1
name = "{name}"

[setup]
script = "\\"$HOME/.local/bin/project_notes\\" link --repo \\"$CODEX_WORKTREE_PATH\\" || echo 'project_notes link failed; notes/ not linked' >&2"
"""


class NotesError(Exception):
    pass


def git(*args: str, cwd: Path | None = None, check: bool = True) -> str:
    result = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and result.returncode != 0:
        raise NotesError(f"git {' '.join(args)} failed in {cwd or os.getcwd()}: {result.stderr.strip()}")
    return result.stdout.strip()


def toplevel(path: Path) -> Path:
    return Path(git("rev-parse", "--show-toplevel", cwd=path))


def worktrees(checkout: Path) -> list[Path]:
    """Return every worktree of `checkout`'s repository, the main one first."""
    out = git("worktree", "list", "--porcelain", cwd=checkout)
    paths = [Path(line[len("worktree ") :]) for line in out.splitlines() if line.startswith("worktree ")]
    return [p for p in paths if p.is_dir()]


def notes_dir(name: str) -> Path:
    return NOTES_ROOT / name


def gitdir_for(name: str) -> Path:
    return GITDIR_ROOT / f"{name}.git"


def ensure_ignored(checkout: Path) -> None:
    """Ignore the notes symlink through info/exclude, shared by every worktree.

    Written even when a .gitignore rule already covers the link, so it stays
    ignored if that rule is ever dropped from a (possibly public) repository.
    """
    common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=checkout))
    exclude = common / "info" / "exclude"
    entry = f"/{LINK_NAME}"
    text = exclude.read_text() if exclude.exists() else ""
    if entry in text.splitlines():
        return
    exclude.parent.mkdir(exist_ok=True)
    with exclude.open("a") as f:
        f.write(("\n" if text and not text.endswith("\n") else "") + entry + "\n")


def in_notes_root(path: Path) -> bool:
    root = NOTES_ROOT.resolve()
    return root == path.resolve() or root in path.resolve().parents


def link_checkout(checkout: Path, target: Path) -> bool:
    """Point `checkout`/notes at `target`. Returns True when a link was created."""
    link = checkout / LINK_NAME
    if link.is_symlink():
        ensure_ignored(checkout)
        if link.resolve() != target.resolve():
            print(f"project_notes: {link} points elsewhere ({os.readlink(link)}); left alone", file=sys.stderr)
        return False
    if link.exists():
        raise NotesError(f"{link} exists and is not a symlink; run `project_notes migrate` first")
    # Ignore before linking so a concurrent `git add -A` never stages the link.
    ensure_ignored(checkout)
    link.symlink_to(target)
    return True


def link_all(main: Path, target: Path) -> None:
    for checkout in worktrees(main):
        if link_checkout(checkout, target):
            print(f"linked {checkout / LINK_NAME} -> {target}")


def configure_notes_repo(target: Path, main: Path, name: str) -> None:
    git("config", CODE_REPO_KEY, str(main), cwd=target)
    remote_base = git("config", "--global", "--get", REMOTE_BASE_KEY, check=False)
    has_origin = "origin" in git("remote", cwd=target).split()
    if remote_base and not has_origin:
        git("remote", "add", "origin", f"{remote_base.rstrip('/')}/{name}_notes.git", cwd=target)
    if (target / "mise.toml").exists() and shutil.which("mise"):
        subprocess.run(["mise", "trust", str(target / "mise.toml")], check=True)


def setup_codex_environment(main: Path) -> None:
    """Make Codex app worktrees link their notes from the environment's setup script.

    The app runs git with hooks disabled, so the global post-checkout hook never
    links its worktrees. Writes a default environment only when the repository
    has none; an existing environment may run its own setup script, so it is
    never edited, only flagged when it doesn't mention project_notes.
    """
    env_dir = main / CODEX_ENV_DIR
    envs = sorted(env_dir.glob("*.toml"))
    if not envs:
        env_dir.mkdir(parents=True, exist_ok=True)
        path = env_dir / "environment.toml"
        path.write_text(CODEX_ENV_TEMPLATE.format(name=main.name))
        print(f"wrote {path} (commit it so Codex worktrees link notes/)")
        return
    for env in envs:
        if "project_notes" not in env.read_text():
            print(
                f"{env} has its own setup script; unless it already runs "
                f'`project_notes link --repo "$CODEX_WORKTREE_PATH"`, add that to it'
            )


def resolve_main(args: argparse.Namespace) -> tuple[Path, str]:
    main = worktrees(toplevel(Path(args.repo).resolve()))[0]
    return main, args.name or main.name


def cmd_init(args: argparse.Namespace) -> None:
    """Create (or adopt) the vault notes repository and link every worktree."""
    main, name = resolve_main(args)
    target, gitdir = notes_dir(name), gitdir_for(name)
    if (main / LINK_NAME).exists() and not (main / LINK_NAME).is_symlink():
        raise NotesError(f"{main / LINK_NAME} already exists; use `project_notes migrate`")
    created = not target.exists()
    if not created:
        if not (target / ".git").exists():
            raise NotesError(f"{target} exists but is not a git repository")
        print(f"reusing existing notes repository {target}")
    else:
        if gitdir.exists():
            raise NotesError(f"{gitdir} already exists without a matching {target}")
        GITDIR_ROOT.mkdir(parents=True, exist_ok=True)
        git("init", f"--separate-git-dir={gitdir}", str(target))
    # Configure before the seed commit so the commit-msg hook stamps it.
    configure_notes_repo(target, main, name)
    # Seed only a repository created here: an adopted one, even without
    # commits, may hold notes or staged work that a seed would overwrite.
    if created:
        (target / "SOMEDAY.md").write_text(SOMEDAY_TEMPLATE.format(date=args.today))
        git("add", "SOMEDAY.md", cwd=target)
        git("commit", "-m", f"Start the {name} notes", "--", "SOMEDAY.md", cwd=target)
    link_all(main, target)
    setup_codex_environment(main)
    if not git("remote", cwd=target):
        print(f"no remote: set `git config --global {REMOTE_BASE_KEY} <base-url>` or add origin by hand")
    else:
        print(
            f"origin is {git('remote', 'get-url', 'origin', cwd=target)}; first push "
            f"(push-to-create makes the repository): git -C {shlex.quote(str(target))} push -u origin HEAD"
        )


def cmd_migrate(args: argparse.Namespace) -> None:
    """Move an in-checkout notes clone (<repo>/notes/.git) into the vault."""
    main, name = resolve_main(args)
    source, target, gitdir = main / LINK_NAME, notes_dir(name), gitdir_for(name)
    if source.is_symlink() or not (source / ".git").is_dir():
        raise NotesError(f"{source} is not a notes clone with its own .git directory")
    for path in (target, gitdir):
        if path.exists():
            raise NotesError(f"{path} already exists")
    GITDIR_ROOT.mkdir(parents=True, exist_ok=True)
    shutil.move(str(source / ".git"), str(gitdir))
    (source / ".git").write_text(f"gitdir: {gitdir}\n")
    shutil.move(str(source), str(target))
    configure_notes_repo(target, main, name)
    # Worktree links pointing at <main>/notes keep resolving once main is linked.
    link_all(main, target)
    setup_codex_environment(main)
    print(f"moved {source} -> {target} (git dir {gitdir})")


def cmd_link(args: argparse.Namespace) -> None:
    """Link one checkout (default: the current one) to its project's notes.

    Silent no-op outside a git repository, inside the notes root itself, or
    for projects without notes, so the global post-checkout hook can call it
    unconditionally. Without a link in the main checkout to follow, a notes
    repository is used only if its recorded code repository is this one, so
    an unrelated clone that merely shares the folder name is never linked.
    """
    try:
        checkout = toplevel(Path(args.repo).resolve())
    except NotesError:
        return
    if in_notes_root(checkout):
        return
    main = worktrees(checkout)[0]
    main_link = main / LINK_NAME
    candidate = notes_dir(main.name)
    if main_link.is_symlink():
        target = main_link.resolve()
    elif (candidate / ".git").exists() and git("config", "--get", CODE_REPO_KEY, cwd=candidate, check=False) == str(main):
        target = candidate
    else:
        return
    if link_checkout(checkout, target):
        print(f"linked {checkout / LINK_NAME} -> {target}")


def frontmatter_errors(path: Path) -> list[str]:
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    if not lines or lines[0].strip() != "---":
        return ["missing YAML frontmatter"]
    fields = {}
    for line in lines[1:]:
        if line.strip() == "---":
            break
        key, sep, rest = line.partition(":")
        if sep:
            fields[key.strip()] = rest.split("#")[0].strip().strip("\"'")
    errors = []
    if fields.get("status") not in STATUSES:
        errors.append(f"status must be one of {', '.join(sorted(STATUSES))}")
    if not DATE_RE.match(fields.get("created_at", "")):
        errors.append("created_at must be YYYY-MM-DD")
    return errors


def note_files(target: Path) -> list[Path]:
    files = []
    for dirpath, dirnames, filenames in os.walk(target):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        files.extend(Path(dirpath) / f for f in filenames if not f.startswith("."))
    return sorted(files)


def markdown_files(target: Path) -> list[Path]:
    """The notes' Markdown files that are on disk (iCloud may have evicted some)."""
    return [p for p in note_files(target) if p.suffix == ".md" and not os.lstat(p).st_flags & SF_DATALESS]


def code_link_re(code_repo: Path) -> re.Pattern | None:
    """Match links into the code repository's forge web UI, capturing the file path.

    Built from its origin remote as https://<host>/<owner>/<repo>, followed by
    GitHub's /blob|tree/<ref>/, GitLab's /-/blob|tree/<ref>/ or Gitea's
    /src/branch/<ref>/.
    """
    m = REMOTE_RE.match(git("remote", "get-url", "origin", cwd=code_repo, check=False))
    if not m:
        return None
    base = re.escape(f"https://{m.group('host')}/{m.group('path')}")
    return re.compile(base + r"(?:/-)?/(?:blob|tree|src/branch)/[^/]+/([^?#]*)")


def link_problems(target: Path, files: list[Path]) -> list[str]:
    """Broken local links: relative ones from the note's real place, forge links in the code checkout.

    Relative links resolve inside the vault, as Obsidian, the forge and a shell
    following the notes/ symlink all see them, so `../` never reaches the code.
    """
    code_repo = Path(git("config", "--get", CODE_REPO_KEY, cwd=target, check=False) or "/nonexistent")
    code_re = code_link_re(code_repo) if code_repo.is_dir() else None
    problems = []
    for path in files:
        for m in LINK_TOKEN_RE.finditer(path.read_text(encoding="utf-8", errors="replace")):
            raw = m.group("inline") or m.group("ref")
            url = raw.strip().strip("<>").split("#")[0].strip() if raw else ""
            code_link = code_re.match(url) if code_re else None
            if code_link:
                resolved = code_repo / code_link.group(1)
            elif not url or URL_SCHEME_RE.match(url):
                continue
            else:
                resolved = path.parent / url
            if not resolved.exists():
                problems.append(f"{path.relative_to(target)}: broken link: {url}")
    return problems


def markdownlint(target: Path, files: list[Path], fix: bool = False) -> bool:
    """Run markdownlint-cli2 with the shared notes style; it prints its own findings.

    Returns False when it reports problems. A missing linter only warns, so the
    pre-commit hook never blocks a commit on tooling alone.
    """
    exe, env = shutil.which("markdownlint-cli2"), None
    if not exe and MARKDOWNLINT_SHIM.exists():
        exe, env = str(MARKDOWNLINT_SHIM), {**os.environ, "MISE_ENV": os.environ.get("MISE_ENV", "mac")}
    if not exe:
        print("project_notes: markdownlint-cli2 not found; Markdown style not checked", file=sys.stderr)
        return True
    if not files:
        return True
    cmd = [exe, "--config", str(MARKDOWNLINT_CONFIG), *(["--fix"] if fix else []), "--"]
    result = subprocess.run(
        cmd + [str(f.relative_to(target)) for f in files], cwd=target, env=env, capture_output=True, text=True
    )
    # Keep the findings, drop the banner and per-run progress lines.
    noise = ("markdownlint-cli2 v", "Finding: ", "Linting: ", "Summary: ")
    findings = [line for line in (result.stdout + result.stderr).splitlines() if not line.startswith(noise)]
    if findings:
        print("\n".join(findings), file=sys.stderr)
    return result.returncode == 0


def lint_problems(target: Path) -> list[str]:
    """Problems in the notes: frontmatter, links, Markdown style, iCloud conflict copies, evicted files."""
    problems = []
    for path in note_files(target):
        rel = path.relative_to(target)
        if ICLOUD_CONFLICT_RE.search(path.stem):
            problems.append(f"{rel}: looks like an iCloud conflict copy")
        if os.lstat(path).st_flags & SF_DATALESS:
            problems.append(f"{rel}: evicted by iCloud (mark the folder Keep Downloaded)")
        elif path.suffix == ".md":
            problems.extend(f"{rel}: {err}" for err in frontmatter_errors(path))
    files = markdown_files(target)
    problems.extend(link_problems(target, files))
    if not markdownlint(target, files):
        problems.append("markdownlint reported problems (`project_notes fmt` fixes most)")
    return problems


def notes_target(checkout: Path, name: str | None) -> Path:
    """The notes repository a code checkout uses: its `notes` link, else the named folder.

    Raises NotesError when that directory is missing, so a check never passes
    vacuously on a project without notes.
    """
    link = checkout / LINK_NAME
    if name is None and link.is_symlink():
        target = link.resolve()
    else:
        target = notes_dir(name or worktrees(checkout)[0].name)
    if not target.is_dir():
        raise NotesError(f"no notes repository at {target}")
    return target


def report(problems: list[str], name: str) -> None:
    for problem in problems:
        print(problem)
    if problems:
        sys.exit(1)
    print(f"{name}: ok")


def lint_target(args: argparse.Namespace) -> Path:
    top = toplevel(Path(args.repo).resolve())
    return top if in_notes_root(top) else notes_target(top, args.name)


def cmd_lint(args: argparse.Namespace) -> None:
    """Check the notes only (frontmatter, links, Markdown style, iCloud state); run from a notes or code checkout."""
    target = lint_target(args)
    report(lint_problems(target), target.name)


def cmd_fmt(args: argparse.Namespace) -> None:
    """Fix the notes' Markdown style (markdownlint-cli2 --fix); run from a notes or code checkout."""
    target = lint_target(args)
    if not markdownlint(target, markdown_files(target), fix=True):
        sys.exit(1)
    print(f"{target.name}: formatted")


def cmd_doctor(args: argparse.Namespace) -> None:
    """Check links, git dir, remote sync, and everything `lint` checks."""
    main, _ = resolve_main(args)
    target = notes_target(main, args.name)
    name = target.name
    problems = []

    if not (target / ".git").is_file():
        raise NotesError(f"{target} is not a notes repository with an external git dir")
    gitdir = Path((target / ".git").read_text().split(":", 1)[1].strip())
    if not gitdir.is_dir():
        problems.append(f"git dir {gitdir} is missing")
    elif "Mobile Documents" in gitdir.parts:
        problems.append(f"git dir {gitdir} is inside iCloud")

    for checkout in worktrees(main):
        link = checkout / LINK_NAME
        if not link.is_symlink() or link.resolve() != target.resolve():
            problems.append(f"{link} is not a symlink to {target}")
        elif subprocess.run(["git", "check-ignore", "-q", LINK_NAME], cwd=checkout).returncode != 0:
            problems.append(f"{link} is not ignored")

    if git("config", "--get", CODE_REPO_KEY, cwd=target, check=False) != str(main):
        problems.append(f"{CODE_REPO_KEY} is not {main}")
    if not git("remote", cwd=target):
        problems.append("no remote configured")
    elif git("rev-parse", "--abbrev-ref", "@{u}", cwd=target, check=False):
        ahead = git("rev-list", "--count", "@{u}..HEAD", cwd=target)
        if ahead != "0":
            problems.append(f"{ahead} unpushed commit(s)")
    else:
        problems.append("HEAD has no upstream")
    dirty = git("status", "--porcelain", cwd=target)
    if dirty:
        problems.append(f"{len(dirty.splitlines())} uncommitted change(s)")

    problems.extend(lint_problems(target))
    report(problems, name)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    commands = (("init", cmd_init), ("migrate", cmd_migrate), ("link", cmd_link), ("doctor", cmd_doctor), ("lint", cmd_lint), ("fmt", cmd_fmt))
    for command, func in commands:
        p = sub.add_parser(command, help=func.__doc__.split("\n")[0] if func.__doc__ else None)
        p.add_argument("--repo", default=".", help="a checkout of the code repository (default: current directory)")
        if command != "link":
            p.add_argument("--name", help="notes folder name (default: the main checkout's directory name)")
        p.set_defaults(func=func)
    args = parser.parse_args()
    if args.command == "init":
        args.today = datetime.date.today().isoformat()
    try:
        args.func(args)
    except NotesError as e:
        sys.exit(f"project_notes: {e}")


if __name__ == "__main__":
    main()
