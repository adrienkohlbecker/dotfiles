{
  "cleanupPeriodDays": 3650,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "sandbox": {
    "excludedCommands": [
      "ssh *",
      "scp *",
      "rsync *",
      "git push *",
      "git fetch *",
      "git pull *",
      "glab *",
      "mise *"
    ],
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "*.githubusercontent.com"
      ]
    },
    "filesystem": {
      "allowWrite": ["~/.cache/uv", "~/.local/share/uv"]
    }
  },
  "permissions": {
    "additionalDirectories": [
      "/Users/ak/Library/Mobile Documents/iCloud~md~obsidian/Documents/Home/Code"
    ],
    "allow": [
      "Bash(shellcheck *)",
      "Bash(git add *)",
      "Bash(grep *)",
      "WebSearch"
    ],
    "deny": [
      "Bash(op read *)",
      "Bash(op item get *)",
      "Bash(security find-generic-password *)",
      "Bash(ansible-vault view *)",
      "Bash(ansible-vault decrypt *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ak/Work/ostinote/.venv/bin/ostinote hook post-tool --agent claude"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ak/Work/ostinote/.venv/bin/ostinote hook session-start --agent claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ak/Work/ostinote/.venv/bin/ostinote hook session-end --agent claude"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "sh /Users/ak/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "outputStyle": "Proactive",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
