prefix_rule(
    pattern=["mise", "run"],
    decision="allow",
    justification="Allow mise tasks outside the sandbox",
)

prefix_rule(
    pattern=["obsidian"],
    decision="allow",
    justification="Allow Obsidian CLI commands outside the sandbox",
)

prefix_rule(
    pattern=["claude"],
    decision="allow",
    justification="Allow Claude CLI commands outside the sandbox",
)

prefix_rule(pattern=["ssh", "lab"], decision="allow")
prefix_rule(pattern=["ssh", "pug"], decision="allow")
prefix_rule(pattern=["ssh", "fox"], decision="allow")
prefix_rule(pattern=["gh"], decision="allow")
prefix_rule(pattern=["glab"], decision="allow")

# Commands that print secret material into the session transcript.
prefix_rule(
    pattern=["op", "read"],
    decision="forbidden",
    justification="Prints a 1Password secret; wire op:// references through op run instead",
    match=["op read op://Private/x/password"],
    not_match=["op run -- env"],
)

prefix_rule(
    pattern=["op", "item", "get"],
    decision="forbidden",
    justification="Prints a 1Password item",
    match=["op item get abc123 --fields password"],
)

prefix_rule(
    pattern=["security", "find-generic-password"],
    decision="forbidden",
    justification="Prints keychain passwords",
    match=["security find-generic-password -s example -w"],
    not_match=["security find-certificate -a"],
)

prefix_rule(
    pattern=["ansible-vault", ["view", "decrypt"]],
    decision="forbidden",
    justification="Prints decrypted vault content",
    match=["ansible-vault view group_vars/prod.yml", "ansible-vault decrypt secrets.yml"],
    not_match=["ansible-vault encrypt_string --encrypt-vault-id test"],
)
